# Discord bot token. Create one at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token

# ID of the Discord server whose channels the bot exposes to the extension
DISCORD_GUILD_ID=replace-with-your-guild-id

# Long random value shared by the bot and the Firefox extension
API_KEY=replace-with-a-long-random-api-key

# Optional settings
API_HOST=127.0.0.1
API_PORT=3541
# Set this when yt-dlp is not available on PATH
# YTDLP_PATH=C:\Tools\yt-dlp.exe
